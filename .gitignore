# Widget Preview related
.widget_preview/
# Vercel CLI link metadata and prebuilt output
.vercel
# Local credentials - never commit. .env holds the Supabase publishable key
# and is where a service-role key would be pasted, so keep it out of history.
.env
!.env.example
.env*
# Vercel writes a VERCEL_OIDC_TOKEN here during "vercel link". That is a
# credential - never commit it.
.env.local
!.env.local.example
